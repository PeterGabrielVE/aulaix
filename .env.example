APP_NAME=AulaX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://aulaix.test

# Base domain used for tenant subdomain resolution (F1-03).
# The central selector lives at APP_DOMAIN; each institution lives at
# {subdomain}.APP_DOMAIN. Add both to your hosts file for local dev
# (see README.md). In production, e.g. APP_DOMAIN=tusistema.com with
# APP_URL=https://tusistema.com and a wildcard DNS record for *.tusistema.com.
# Keep SESSION_DOMAIN=null so each institution's login cookie stays on its
# own subdomain.
APP_DOMAIN=aulaix.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aulaix
# Non-superuser, non-BYPASSRLS role that owns the schema — see docker/postgres/init.sql.
DB_USERNAME=aulaix_app
DB_PASSWORD=aulaix_app_password
# Bootstrap superuser used only by the postgres container itself on first init.
DB_ROOT_USERNAME=postgres
DB_ROOT_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aulaix.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Decoupled AI module (skeleton only in Fase 1) — see app/Services/AI.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=5

VITE_APP_NAME="${APP_NAME}"
