# syntax=docker/dockerfile:1

# Production images, built by CI/CD. Two targets:
#   app — php-fpm with the code, vendor/ and compiled assets baked in
#   web — nginx serving public/ and proxying PHP to app:9000
# (docker/php/Dockerfile is the development image: code is bind-mounted.)

FROM php:8.4-fpm-alpine AS base

RUN apk add --no-cache libpq libzip libpng libjpeg-turbo freetype icu-libs \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        postgresql-dev \
        libzip-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        icu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_pgsql \
        pgsql \
        pcntl \
        bcmath \
        zip \
        gd \
        intl \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

# --- PHP dependencies (no dev packages) -------------------------------------
FROM base AS vendor

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app

# Lock files first so this layer stays cached until dependencies change.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

COPY . .
RUN composer dump-autoload --optimize --no-dev --no-scripts

# --- Frontend assets ---------------------------------------------------------
FROM node:25-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY vite.config.js jsconfig.json ./
COPY resources ./resources
# app.js imports Ziggy from vendor/, and app.css @source-s the pagination views.
COPY --from=vendor /app/vendor ./vendor

ARG VITE_APP_NAME=AulaX
ENV VITE_APP_NAME=${VITE_APP_NAME}
RUN npm run build

# --- php-fpm runtime -----------------------------------------------------------
FROM base AS app

WORKDIR /var/www/html

COPY --from=vendor --chown=www-data:www-data /app ./
COPY --from=assets --chown=www-data:www-data /app/public/build ./public/build
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/99-aulaix.ini
COPY docker/php/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && su www-data -s /bin/sh -c "php artisan package:discover --ansi"

USER www-data

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm"]

# --- nginx ---------------------------------------------------------------------
FROM nginx:1.27-alpine AS web

COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
