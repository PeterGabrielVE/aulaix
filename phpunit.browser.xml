<?xml version="1.0" encoding="UTF-8"?>
<!-- Browser tests (SPEC-013 NAV-NF04, NF05), apart from the main suite:
     docker compose, profile browser: run the browser service. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- The architecture tests parse every file of src/ and app/ in the
             same process as the rest of the suite; 256M no longer fits. -->
        <ini name="memory_limit" value="512M"/>
        <!-- force="true" on every entry: docker-compose.yml sets APP_ENV as a
             real container environment variable (visible via getenv() before
             PHPUnit even starts), and PHPUnit's <env> only overrides an
             already-set variable when force="true" — without it, the
             container's APP_ENV=local silently wins and CSRF's
             runningUnitTests() bypass never kicks in (419 on every POST). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Postgres, not sqlite: RLS (F1-02) uses Postgres-only features
             (set_config, FORCE ROW LEVEL SECURITY, current_setting), so the
             test suite runs against a real Postgres database. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="aulaix_testing" force="true"/>
        <env name="DB_USERNAME" value="aulaix_app" force="true"/>
        <env name="DB_PASSWORD" value="aulaix_app_password" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Chromium resolves every *.localhost to this machine: each
             institution opens at <subdomain>.localhost (SPEC-013 PR D). -->
        <env name="APP_DOMAIN" value="localhost" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- The browser keeps its session between requests. -->
        <env name="SESSION_DRIVER" value="file" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
